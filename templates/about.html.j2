{% extends "_base.html.j2" %}
{% block title %}{{ t("meta.about.title") }}{% endblock %}
{% block description %}{{ t("meta.about.description") }}{% endblock %}
{% block head %}
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --ink: #22252a;
      --muted: #5f646b;
      --rule: #d4d6d9;
      --wash: #f2f3f4;
      --focus: #1d5fa8;
    }
    body {
      font-family: system-ui, sans-serif;
      background: #fff;
      color: var(--ink);
      line-height: 1.6;
      font-size: 16px;
    }
    a { color: var(--focus); }
    :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
    .site-nav {
      display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 18px;
      max-width: 46rem; margin: 0 auto; padding: 14px 20px;
      border-bottom: 1px solid var(--rule);
      font-size: 14px;
    }
    .site-nav a { text-decoration: none; }
    .site-nav a:hover { text-decoration: underline; }
    .site-nav .home { font-weight: 650; color: var(--ink); margin-right: auto; }
    .site-nav [aria-current] { color: var(--ink); }
    main { max-width: 46rem; margin: 0 auto; padding: 32px 20px 56px; }
    h1 { font-size: 30px; line-height: 1.2; margin-bottom: 14px; }
    .lede { font-size: 18px; color: var(--muted); margin-bottom: 8px; }
    h2 { font-size: 21px; margin: 40px 0 10px; }
    h3 { font-size: 16px; margin: 26px 0 6px; }
    p, ul, ol { margin-bottom: 12px; }
    ul, ol { padding-left: 22px; }
    li { margin-bottom: 4px; }
    code { font-size: 0.88em; background: var(--wash); padding: 1px 4px; border-radius: 2px; }
    .table-wrap { overflow-x: auto; margin: 14px 0 18px; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 7px 10px 7px 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
    th { font-weight: 650; border-bottom-color: var(--ink); }
    td.num { font-variant-numeric: tabular-nums; white-space: nowrap; }
    footer {
      max-width: 46rem; margin: 0 auto; padding: 18px 20px 32px;
      border-top: 1px solid var(--rule);
      font-size: 13px; color: var(--muted);
    }
  </style>
{% endblock %}
{% block body %}
<body>

<nav class="site-nav">
  <a class="home" href="./">Brussels Pedestrian Network</a>
  <a href="./">{{ t("common.nav.map") }}</a>
  <a href="./stats.html">{{ t("common.nav.stats") }}</a>
  <a href="./evolution.html">{{ t("common.nav.evolution") }}</a>
  <a href="./about.html" aria-current="page">{{ t("common.nav.about") }}</a>
</nav>

<main data-i18n-fragment="about">
{% include ["about/" ~ lang ~ ".html", "about/" ~ reference ~ ".html"] %}
</main>

{% set maintainer %}<a href="https://github.com/PasLoin/Brussels-Pedestrian-Network">PasLoin</a>{% endset %}
{% set osm %}<a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>{% endset %}
<footer>
  {{ t("about.footer", maintainer=maintainer, osm=osm) }}
</footer>

</body>
</html>
{% endblock %}
