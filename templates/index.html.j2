{% extends "_base.html.j2" %}
{% block title %}{{ t("meta.index.title") }}{% endblock %}
{% block description %}{{ t("meta.index.description") }}{% endblock %}
{% block head %}
  <link href="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.css" rel="stylesheet" />
  <link href="{{ root }}app.css" rel="stylesheet" />
  <script src="https://unpkg.com/maplibre-gl@4/dist/maplibre-gl.js"></script>
  <script src="https://unpkg.com/pmtiles@3/dist/pmtiles.js"></script>
{% endblock %}
{% block body %}
<body>
{% include "_lang_banner.html.j2" %}

<div id="map"></div>

<div id="header" class="open">
  <h1 class="header-title">
    <button id="header-toggle" type="button" aria-expanded="true" aria-controls="header-content">
      <img src="{{ root }}favicon.svg" alt="" width="20" height="20" />
      <span>Brussels Pedestrian Network</span>
      <svg aria-hidden="true" class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
  </h1>
  <div id="header-content">
    <p class="subtitle">{{ t("header.subtitle") }}</p>
    <p class="header-meta"><span id="osm-date">{{ t("common.loading") }}</span> <span id="build-date"></span></p>

    <nav class="header-nav" aria-label="{{ t("header.pages") }}">
      <a href="{{ home }}stats.html">{{ t("common.nav.stats") }}</a>
      <a href="{{ home }}evolution.html">{{ t("common.nav.evolution") }}</a>
      <a href="{{ home }}about.html">{{ t("common.nav.about") }}</a>
{% include "_lang_switch.html.j2" %}
    </nav>

    <div class="flow-filter-wrap">
      <label class="flow-filter-label" id="flow-threshold-label" for="flow-threshold-slider">
        {{ t("header.flowThreshold") }} <span id="flow-threshold-val">0 %</span>
      </label>
      <input id="flow-threshold-slider" type="range" min="0" max="95" step="5" value="0" />
    </div>

    <div class="header-tools">
      <button id="nav-btn" type="button" class="tool-btn loading" aria-busy="true" aria-live="polite">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="19" r="2"/><circle cx="18" cy="5" r="2"/><path d="M8 19h7a3.5 3.5 0 0 0 0-7H9a3.5 3.5 0 0 1 0-7h7"/>
        </svg>
        <span id="nav-btn-label">{{ t("nav.loadingGraph") }}</span>
      </button>
      <div id="nav-hint" aria-live="polite"></div>
{% if edit_env %}
      <button id="edit-enter" type="button" class="tool-btn">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="m13.5 6.5 4 4"/>
        </svg>
        <span>{{ t("edit.mode.enter") }}</span>
        <span id="edit-enter-pending" class="pending-count" hidden></span>
      </button>
{% endif %}
      <a id="edit-btn" class="tool-link disabled" aria-disabled="true" tabindex="-1" href="#" target="_blank" rel="noopener">{{ t("header.editInOsm") }}</a>
      <div id="edit-hint">{{ t("header.editHint", zoom=16) }}</div>
    </div>
  </div>
</div>
{% if edit_env %}
<div id="edit-bar" role="region" aria-label="{{ t("edit.mode.title") }}" hidden>
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 20h4L19 9l-4-4L4 16v4z"/><path d="m13.5 6.5 4 4"/>
  </svg>
  <span class="edit-bar-title">{{ t("edit.mode.title") }}</span>
  <span class="edit-env">{{ edit_env }}</span>
  <button id="edit-exit" type="button">{{ t("edit.mode.exit") }}</button>
</div>
<dialog id="edit-exit-dialog" aria-labelledby="edit-exit-title">
  <h2 id="edit-exit-title">{{ t("edit.mode.exitTitle") }}</h2>
  <p id="edit-exit-text"></p>
  <div class="dialog-actions">
    <button type="button" class="btn-primary" data-exit-choice="keep">{{ t("edit.mode.keep") }}</button>
    <button type="button" class="btn-danger" data-exit-choice="discard">{{ t("edit.mode.discard") }}</button>
    <button type="button" class="btn-plain" data-exit-choice="stay">{{ t("edit.mode.stay") }}</button>
  </div>
</dialog>
{% endif %}

<div id="route-panel">
  <h2>{{ t("route.title") }}</h2>
  <div class="route-summary" id="route-dist"></div>
  <div class="route-time" id="route-time"></div>
  <div class="route-bar">
    <div class="route-bar-seg route-bar-ped" id="bar-ped"></div>
    <div class="route-bar-seg route-bar-road" id="bar-road"></div>
    <div class="route-bar-seg route-bar-cyc" id="bar-cyc"></div>
  </div>
  <div class="route-breakdown">
    <div class="route-row">
      <div class="route-dot route-bar-ped"></div>
      <span class="rlabel">{{ t("route.pedestrian") }}</span>
      <span class="rvalue" id="stat-ped-m"></span>
      <span class="rpct" id="stat-ped-pct"></span>
    </div>
    <div class="route-row">
      <div class="route-dot route-bar-road"></div>
      <span class="rlabel">{{ t("route.roadway") }}</span>
      <span class="rvalue" id="stat-road-m"></span>
      <span class="rpct" id="stat-road-pct"></span>
    </div>
    <div class="route-row">
      <div class="route-dot route-bar-cyc"></div>
      <span class="rlabel">{{ t("route.cyclewayNoFoot") }}</span>
      <span class="rvalue" id="stat-cyc-m"></span>
      <span class="rpct" id="stat-cyc-pct"></span>
    </div>
  </div>
  <button id="route-clear" type="button">{{ t("route.clear") }}</button>
</div>

<div id="legend" class="open">
  <button id="legend-toggle" type="button" aria-expanded="true" aria-controls="legend-content">
    {{ t("legend.title") }}
    <svg aria-hidden="true" class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="6 9 12 15 18 9"/>
    </svg>
  </button>
  <div id="legend-content"></div>
</div>
{% if edit_env %}
<aside id="edit-dock" class="open" data-position="right" hidden aria-labelledby="edit-panel-title">
  <div class="edit-dock-bar">
    <button id="edit-dock-toggle" type="button" aria-expanded="true" aria-controls="edit-panel">
      <span id="edit-panel-title">{{ t("edit.panel.title") }}</span>
      <svg aria-hidden="true" class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"/>
      </svg>
    </button>
    <div id="edit-dock-position" role="group" aria-label="{{ t("edit.dock.position") }}">
      <button type="button" data-dock="left" aria-pressed="false" aria-label="{{ t("edit.dock.left") }}" title="{{ t("edit.dock.left") }}">
        <svg aria-hidden="true" viewBox="0 0 20 14"><rect x="0.75" y="0.75" width="18.5" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="2.5" width="5" height="9" rx="1" fill="currentColor"/></svg>
      </button>
      <button type="button" data-dock="bottom" aria-pressed="false" aria-label="{{ t("edit.dock.bottom") }}" title="{{ t("edit.dock.bottom") }}">
        <svg aria-hidden="true" viewBox="0 0 20 14"><rect x="0.75" y="0.75" width="18.5" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="2.5" y="7.5" width="15" height="4" rx="1" fill="currentColor"/></svg>
      </button>
      <button type="button" data-dock="right" aria-pressed="true" aria-label="{{ t("edit.dock.right") }}" title="{{ t("edit.dock.right") }}">
        <svg aria-hidden="true" viewBox="0 0 20 14"><rect x="0.75" y="0.75" width="18.5" height="12.5" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="12.5" y="2.5" width="5" height="9" rx="1" fill="currentColor"/></svg>
      </button>
    </div>
  </div>
  <section id="edit-panel">
    <div id="edit-auth" aria-live="polite"></div>
    <div id="edit-status" aria-live="polite"></div>
    <div id="edit-nav"></div>
    <div id="edit-detail"></div>
    <div id="edit-queue"></div>
  </section>
</aside>
{% endif %}
<div id="zoom-badge">{{ t("map.zoom") }} <span id="zoom-val"></span></div>

<div id="basemap-control">
  <button id="basemap-toggle" type="button" title="{{ t("basemap.menu") }}" aria-label="{{ t("basemap.menu") }}" aria-expanded="false" aria-controls="basemap-menu">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
      <path d="M12 3 2 8l10 5 10-5-10-5Z" fill="#fff"/>
      <path d="m2 12 10 5 10-5"/>
      <path d="m2 16 10 5 10-5"/>
    </svg>
  </button>
  <div id="basemap-menu" role="radiogroup" aria-label="{{ t("basemap.menu") }}"></div>
</div>

<script src="{{ root }}nav.js"></script>
<script src="{{ root }}filters.js"></script>
<script src="{{ root }}html.js"></script>
<script src="{{ root }}popups.js"></script>
{% if edit_env %}
<script src="{{ root }}vendor/osm-api-4.0.1.min.js"></script>
<script type="module" src="{{ root }}edit/main.js"></script>
{% endif %}
<script type="module" src="{{ root }}map/main.js"></script>
</body>
</html>
{% endblock %}
