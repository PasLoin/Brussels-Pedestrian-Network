<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="Content-Security-Policy" content="{{ csp }}" />
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>404 · Brussels Pedestrian Network</title>
  <link rel="icon" type="image/svg+xml" href="{{ site_url }}favicon.svg" />
  <style>
    :root { color-scheme: light dark; --bg: #f5f6f8; --fg: #1d2433; --muted: #5a6478; --accent: #1d4ed8; --card: #fff; }
    @media (prefers-color-scheme: dark) { :root { --bg: #11151f; --fg: #e6e9f0; --muted: #a0a8b8; --accent: #93c5fd; --card: #1a2030; } }
    body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: var(--bg); color: var(--fg); font: 16px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif; }
    main { max-width: 34rem; padding: 2rem 1.25rem; }
    .code { font-size: 3.5rem; font-weight: 700; color: var(--accent); margin: 0 0 1rem; }
    section { background: var(--card); border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; }
    h1 { font-size: 1.15rem; margin: 0 0 0.25rem; }
    p { margin: 0 0 0.5rem; color: var(--muted); }
    a { color: var(--accent); font-weight: 600; }
  </style>
</head>
<body>
  <main>
    <div class="code" aria-hidden="true">404</div>
{% for s in sections %}
    <section lang="{{ s.lang }}">
      <h1>{{ s.t("notFound.title") }}</h1>
      <p>{{ s.t("notFound.text") }}</p>
      <a href="{{ s.url }}" hreflang="{{ s.lang }}">{{ s.t("common.nav.backToMap") }}</a>
    </section>
{% endfor %}
  </main>
</body>
</html>
